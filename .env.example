# ---------------------------------------------------------------------------
# Copy to `.env` and fill in the keys you need. `.env` is git-ignored.
# You only have to set the credentials for the data sources / scorers you use.
# ---------------------------------------------------------------------------

# --- Market prices (Alpaca is optional; yfinance / stooq are free fallbacks)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- News sources (configure at least one)
# Alpaca News (requires the Alpaca keys above)
# Finnhub: https://finnhub.io/
FINNHUB_API_KEY=
# Polygon: https://polygon.io/
POLYGON_API_KEY=
# GDELT is keyless and needs no configuration.

# --- Sentiment scorers (pick one; see `sentiment_models.build_scorer`)
# OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=

# Volcengine Ark (Doubao / DeepSeek models served via Ark)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# ZhipuAI GLM
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=

# Self-hosted FinGPT behind an OpenAI-compatible vLLM/TGI server
FINGPT_BASE_URL=
FINGPT_API_KEY=
FINGPT_MODEL=

# FinBERT runs offline after the HuggingFace model is cached locally.
# Set this to a mirror if huggingface.co is unreachable from your network:
# HF_ENDPOINT=https://hf-mirror.com
HF_ENDPOINT=
